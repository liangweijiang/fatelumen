# Copy this file to backend/.env.local and fill only your local development values.
# backend/.env.local is ignored by Git. Never put real credentials in compose.yaml,
# committed .env files, screenshots, logs, or chat messages.

AUTH_PROVIDERS=google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/api/v1/auth/google/callback

# Generate separate long random values for local JWT signing. Keep them only
# in backend/.env.local; this example contains no usable credential.
JWT_SECRET=
ADMIN_JWT_SECRET=
JWT_EXPIRE_HOURS=168
